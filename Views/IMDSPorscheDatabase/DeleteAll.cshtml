@using CSVWorker.Models.Entities

@{
    ViewData["Title"] = "Clear Porche Database";
}

<h1 class="fs-3 text-danger">Confirm Clear Database!</h1>


<div class="card">
    <div class="card-body">
         <form asp-action="DeleteAll">
            <div class="row mb-6">
                <p class="text-danger fs-xlarge">Are you sure you want to delete everything in Porsche Database?</p>
                <p class="text-warning fs-large">
                    This will delete all the data in the database and cannot be undone. It can be helpful if you want to start fresh or if the database was corrupted.
                </p>
                <p class="text-warning fs-large">
                    Please make sure you have a backup file in case you want to restore it.
                </p>
                <p class="text-warning">
                    You can download the backup file by clicking "Export Database" button from the table page.
                    If you want to restore the data from the backup, just go to "Update from CSV" and send it.
                </p>
            </div>
            <div class="row mb-6">
                <div class="col-sm-10">
                    <button type="submit" class="btn btn-danger">Confirm Delete All</button>
                    <a asp-action="Index" class="btn btn-secondary mx-2">Back</a>
                </div>
            </div>
         </form>
    </div>
</div>
