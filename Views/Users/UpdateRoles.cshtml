@using CSVWorker.Models.Entities

@{
    ViewData["Title"] = "Edit";
}

<!-- Basic Layout -->
<div class="col-xxl">
    <div class="card">
        <div class="card-header d-flex align-items-center justify-content-between">
            <h5 class="mb-0">Manage User Roles</h5>
            <small class="text-body-secondary float-end">Users Manager</small>
        </div>
        <div class="card-body">
            <form asp-action="UpdateRoles">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="row mb-6">
                    <label class="col-sm-2 col-form-label">Roles</label>
                    <div class="col-sm-10">
                        <div class="list-group">
                            @if (ViewBag.RolesList is IEnumerable<SelectListItem> rolesList)
                            {
                                @foreach (var role in rolesList)
                                {

                                    <label class="list-group-item">
                                        <input class="form-check-input me-1" type="checkbox" name="selectedRoles"
                                               value="@role.Value" id="profil_@role.Value" checked="@role.Selected" />
                                        @role.Text
                                    </label>

                                }
                            }
                        </div>
                    </div>
                </div>
                <div class="row justify-content-end">
                    <div class="col-sm-10">
                        <button type="submit" class="btn btn-primary">Edit</button>
                        <a asp-action="Index" class="btn btn-secondary mx-2">Back</a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>